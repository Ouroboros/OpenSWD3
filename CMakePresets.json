{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux",
      "displayName": "Linux i386 (WSL, clang, static)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "toolchainFile": "${sourceDir}/cmake/toolchain-linux-i386-clang.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows x86 (clang-cl cross from WSL)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows",
      "toolchainFile": "${sourceDir}/cmake/toolchain-windows-x86-clang-cl.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux", "configurePreset": "linux" },
    { "name": "windows", "configurePreset": "windows" }
  ],
  "testPresets": [
    { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } }
  ]
}
