{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux",
      "displayName": "Linux (WSL, LLVM)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/llvm/bin/clang++"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows x86 (clang-cl cross from WSL)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows",
      "toolchainFile": "${sourceDir}/cmake/toolchain-windows-x86-clang-cl.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux", "configurePreset": "linux" },
    { "name": "windows", "configurePreset": "windows" }
  ]
}
