set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR i686)

set(SWD3_LLVM_ROOT "/opt/llvm" CACHE PATH "LLVM install root")
set(SWD3_I386_SYSROOT "/opt/sysroot-i386" CACHE PATH "Ubuntu i386 multilib sysroot (libc6-dev-i386, lib32stdc++-13-dev, ...)")

set(CMAKE_C_COMPILER "${SWD3_LLVM_ROOT}/bin/clang")
set(CMAKE_CXX_COMPILER "${SWD3_LLVM_ROOT}/bin/clang++")
set(CMAKE_AR "${SWD3_LLVM_ROOT}/bin/llvm-ar")
set(CMAKE_RANLIB "${SWD3_LLVM_ROOT}/bin/llvm-ranlib")
set(CMAKE_C_COMPILER_TARGET x86_64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET x86_64-linux-gnu)
set(CMAKE_SYSROOT "${SWD3_I386_SYSROOT}")

set(CMAKE_C_FLAGS_INIT "-m32 -D_FILE_OFFSET_BITS=64")
set(CMAKE_CXX_FLAGS_INIT "-m32 -D_FILE_OFFSET_BITS=64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-m32 -static")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
